<Application x:Class="StreamMirror.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StreamMirror"
             ThemeMode="Dark">
    <Application.Resources>
        <!-- The palette, taken from the icon: a deep navy ground, a darker rail, lighter cards, and the icon's cyan for every
             control and the app's own marks. Red is kept for "on air", amber for a problem. -->
        <SolidColorBrush x:Key="Accent" Color="#2E9BFF" />
        <SolidColorBrush x:Key="AccentHover" Color="#5AB1FF" />
        <SolidColorBrush x:Key="OnAccent" Color="#04112A" />
        <SolidColorBrush x:Key="Live" Color="#1A9450" />
        <SolidColorBrush x:Key="Warn" Color="#F5B342" />
        <SolidColorBrush x:Key="Ice" Color="#C9D6FF" />
        <SolidColorBrush x:Key="Muted" Color="#9DA9C8" />
        <SolidColorBrush x:Key="Text" Color="#EEF2FC" />
        <SolidColorBrush x:Key="Line" Color="#243056" />
        <SolidColorBrush x:Key="Panel" Color="#131B36" />
        <SolidColorBrush x:Key="Field" Color="#0F1630" />
        <SolidColorBrush x:Key="Rail" Color="#090E20" />
        <SolidColorBrush x:Key="RailSelected" Color="#15203F" />
        <SolidColorBrush x:Key="RailHover" Color="#101834" />
        <SolidColorBrush x:Key="WindowBack" Color="#0D1328" />
        <SolidColorBrush x:Key="Picture" Color="#080C1C" />

        <!-- The theme's controls take their accent from Windows; these keys hand them the icon's cyan instead (in the dark
             theme fills use Light2, accent text Light3). -->
        <Color x:Key="{x:Static SystemColors.AccentColorKey}">#1E86F0</Color>
        <Color x:Key="{x:Static SystemColors.AccentColorLight1Key}">#2B93FB</Color>
        <Color x:Key="{x:Static SystemColors.AccentColorLight2Key}">#2E9BFF</Color>
        <Color x:Key="{x:Static SystemColors.AccentColorLight3Key}">#8CC8FF</Color>
        <Color x:Key="{x:Static SystemColors.AccentColorDark1Key}">#1E6FE0</Color>
        <Color x:Key="{x:Static SystemColors.AccentColorDark2Key}">#1757B3</Color>
        <Color x:Key="{x:Static SystemColors.AccentColorDark3Key}">#103F85</Color>
        <!-- Lists, menus and tooltips on the navy, not the theme's grey. -->
        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#162048" />
        <SolidColorBrush x:Key="ContextMenuBackground" Color="#162048" />
        <SolidColorBrush x:Key="ToolTipBackground" Color="#162048" />
        <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#162048" />
        <!-- Windows 11's variable fonts, with Segoe UI where they are missing (Windows 10). -->
        <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
        <!-- The icon font of Windows 11, and of Windows 10 where the first is missing. -->
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- No implicit Button style here: it would replace the theme's dark button template with the classic light one. -->
        <!-- A scroll viewer's viewport height minus the margins of the panel inside it (see the Mirror tab). -->
        <local:LessMarginConverter x:Key="LessMargin" />

        <!-- One spacing for every page: 28 px to the sides, 20 above, 16 below; 10 px between cards. -->
        <Thickness x:Key="PageMargin">28,20,28,16</Thickness>

        <!-- A card: one topic's settings, on a slightly lighter ground with a thin line around it. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,13,16,14" />
        </Style>
        <!-- The name of a card, over its contents. -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- A small heading inside a card, over a few of its settings. -->
        <Style x:Key="SubTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <!-- The name of a page, top left. -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <!-- Explaining text: muted, 12 px, wrapping. -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- A glyph of the icon font. -->
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Every check box is a switch: its words, then the switch. Off: an outlined track; on: a cyan one. -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="Words" VerticalAlignment="Center" Margin="0,0,12,0" RecognizesAccessKey="True"
                                              TextElement.Foreground="{StaticResource Text}" />
                            <Border x:Name="Track" Grid.Column="1" Width="40" Height="20" CornerRadius="10" BorderThickness="1.5"
                                    BorderBrush="{StaticResource Muted}" Background="Transparent" VerticalAlignment="Center">
                                <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{StaticResource Muted}" HorizontalAlignment="Left" Margin="3,0" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter TargetName="Words" Property="Margin" Value="0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Text}" />
                                <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Knob" Property="Fill" Value="{StaticResource OnAccent}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentHover}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentHover}" />
                                <Setter TargetName="Knob" Property="Fill" Value="{StaticResource OnAccent}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A button that looks like the text it holds: for a heading that opens or folds what is under it. The keyboard
             reaches it (and shows where it is), and a screen reader names it. -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="2,1,6,1" />
            <Setter Property="Margin" Value="-2,-1,0,-1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource RailSelected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The rail's entries: one per page. Selected = lighter ground and full-strength text. -->
        <Style x:Key="RailItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Back" Background="Transparent" CornerRadius="6" Padding="10,8" SnapsToDevicePixels="True">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Bar" Width="3" CornerRadius="1.5" Margin="0,9" HorizontalAlignment="Left" Background="{StaticResource Accent}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource RailHover}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                <Setter TargetName="Back" Property="Padding" Value="10,14,10,4" />
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource RailSelected}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- A group heading: not a page, so it cannot be chosen. -->
                <DataTrigger Binding="{Binding IsHeading}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Focusable" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A page shows its icon and its name, and a dot while it has something live to say; a group heading shows as
             small muted words (a thin line in the narrow rail). -->
        <DataTemplate x:Key="RailFull">
            <Grid>
                <DockPanel x:Name="Page">
                    <Ellipse DockPanel.Dock="Right" Width="7" Height="7" Fill="{Binding Dot}" VerticalAlignment="Center" Margin="6,1,0,0" />
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="16" Width="30" FontWeight="Normal" />
                    <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="Heading" Text="{Binding Title}" FontSize="12" Foreground="{StaticResource Muted}" Opacity="0.75" Visibility="Collapsed" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHeading}" Value="True">
                    <Setter TargetName="Page" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Heading" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- The narrow rail: the icon alone, and the page's name as its tooltip. -->
        <DataTemplate x:Key="RailShort">
            <Grid Background="Transparent" ToolTip="{Binding Title}">
                <Grid x:Name="Page">
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="16" FontWeight="Normal" HorizontalAlignment="Center" />
                    <Ellipse Width="6" Height="6" Fill="{Binding Dot}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0" />
                </Grid>
                <Border x:Name="Heading" Height="1" Background="{StaticResource Line}" Visibility="Collapsed" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHeading}" Value="True">
                    <Setter TargetName="Page" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Heading" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- The pages: only the selected one is shown; the rail on the left is the list of them. -->
        <ControlTemplate x:Key="PagesOnly" TargetType="TabControl">
            <ContentPresenter ContentSource="SelectedContent" />
        </ControlTemplate>
    </Application.Resources>
</Application>
